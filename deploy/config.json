{
  "database_path": "/data/state.db",
  "adapters": [
    {
      "id": "nginx",
      "socket_path": "/ipc/nginx/adapter.sock"
    },
    {
      "id": "cowrie",
      "socket_path": "/ipc/cowrie/adapter.sock"
    }
  ],
  "ssh": {
    "window_seconds": 900,
    "pair_threshold": 6,
    "distinct_username_threshold": 6,
    "excluded_usernames": [],
    "trusted_cidrs": []
  },
  "http": {
    "eligible_statuses": [400, 403, 404],
    "excluded_exact_paths": ["/health"],
    "excluded_path_prefixes": []
  },
  "publication": {
    "source_id": "gasserp-azure-weu-01",
    "source_epoch_path": "/data/source-epoch",
    "private_key_path": "/data/source-private-key.pem",
    "key_id": "gasserp-azure-weu-01-ed25519-1",
    "classifier_version": "probing-classifier-v1",
    "outbox_directory": "/outbox"
  }
}
